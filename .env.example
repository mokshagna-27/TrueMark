# ==============================================================================
# TrueMark Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual settings.
# Do NOT commit actual secrets or credentials to version control.
# ==============================================================================

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Database Configuration
# PostgreSQL using psycopg (version 3) driver:
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/truemark_db

# Evidence Retrieval Module Configuration (Planned)
RETRIEVAL_API_KEY=your_retrieval_api_key_here
RETRIEVAL_PROVIDER=duckduckgo
RETRIEVAL_MAX_RESULTS=5

# AI Analysis Module Configuration (Planned)
AI_API_KEY=your_ai_service_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# --- Optional: AI review layer used by the web app's analysis endpoints ---
# Leave unset to run rule-based checks only. Only PII-redacted text is sent.
# TRUEMARK_LLM_API_KEY=
# TRUEMARK_LLM_MODEL=gpt-4o-mini
# TRUEMARK_LLM_BASE_URL=https://api.openai.com/v1
# Folder with brand_pack.json / source_registry.json / *.md approved sources
# TRUEMARK_DATA_DIR=
# Extra allowed frontend origins (comma-separated)
# CORS_ORIGINS=https://your-frontend.vercel.app
